<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <ApplicationManifest>TestClient64.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloWorldLib.Interop\HelloWorldLib.Interop.csproj" />
    <ProjectReference Include="..\HelloWorldLib\HelloWorldLib.csproj" />
  </ItemGroup>

  <!-- Copy COM host DLLs to output directory -->
  <ItemGroup>
    <Content Include="..\HelloWorldLib\bin\Release\net8.0\HelloWorldLib.comhost.dll">
      <Link>HelloWorldLib.comhost.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
