<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x86</PlatformTarget>
    <EnableComHosting>true</EnableComHosting>
    <GenerateComHost>true</GenerateComHost>
    <ComVisible>true</ComVisible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefineConstants>X86</DefineConstants>
    <AssemblyManifest>HelloWorldLib32.manifest</AssemblyManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloWorldLib.Interop\HelloWorldLib.Interop.csproj" />
  </ItemGroup>

</Project>
